{
  "manifest_version": 3,
  "name": "NexGrab - Video Downloader",
  "short_name": "NexGrab",
  "version": "3.3.0",
  "description": "Har video par NexGrab button: ek click mein video NexGrab PC app mein download. YouTube, Instagram, Facebook, TikTok, X + 1000 sites.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "NexGrab", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
